# Generated data - the shipped artifact is tools/generate_data.py, never the data itself.
data/

# Reports are regenerated by tools/sales_report.py -- never shipped, always derived.
reports/

# Python
__pycache__/
*.pyc
.venv/
venv/

# kibsu working state -- index and vendored hook/bin are regenerated by
# `python -m kibsu index .` and `python -m kibsu install --install .` / `gate --install --apply`.
# .kibsu/gate_baseline.json is DELIBERATELY tracked -- it is the record of what this repo
# agreed to live with (see skills/gate/SKILL.md); do not add it here.
.kibsu/index.json
.kibsu/hooks/
.kibsu/bin/
.kibsu/install.json
